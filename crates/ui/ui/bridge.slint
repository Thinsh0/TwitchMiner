// The contract between the Rust controller and the views. Everything shown comes from
// these properties (derived from the engine state); everything done goes through these
// callbacks (turned into engine commands).

import { Tone, SegmentItem } from "widgets.slint";

export enum Screen { home, drops, channels, activity, settings }

// What the window shows: starting up, the "choose an engine" screen, or the app.
export enum Conn { starting, setup, ready }

export enum LinkState { local, connected, connecting, down }

// Why the "choose an engine" screen is shown.
export enum SetupReason { none, busy, failed }

// Why a remote engine is unreachable (`tm_client::Fault`); `other` shows the raw error.
export enum Fault { none, not-https, bad-token, refused, unknown-host, no-answer, bad-url, other }

export enum ToastKind { plain, error, login-ok, claimed, invalid, copied, backup, manifest, drop-claimed, api-off, unreachable, timeout }

export struct AccountItem {
    id: string,
    name: string,
    login: string,
    initial: string,
    avatar: image,
    // running | starting | stopped | auth_required | error | standby
    status: string,
    // Peer name (standby) or error message.
    detail: string,
    enabled: bool,
}

export struct LoginItem {
    flow-id: string,
    code: string,
    // Activation page, as shown.
    url: string,
    // Same page with the code pre-filled, to open.
    link: string,
    // Local time, `HH:MM`.
    expires-at: string,
}

export struct NoticeItem {
    id: string,
    // info | warning | error
    level: string,
    // English fallback, shown for a kind this interface does not know.
    message: string,
    // update | duplicate | proxy_invalid | realtime_down (or another, newer kind)
    kind: string,
    // Parameters of the kind (empty when absent).
    login: string,
    peer: string,
    version: string,
    current: string,
    url: string,
    error: string,
}

export struct ToastItem {
    id: int,
    kind: ToastKind,
    // Message from the engine (error message) or already-composed text.
    detail: string,
    tone: Tone,
}

// A plan entry that needs the user (À faire): not_linked | at_risk | will_miss.
export struct PlanTodo {
    kind: string,
    campaign-id: string,
    campaign: string,
    game: string,
    rewards: string,
    link-url: string,
    // Minutes until the campaign ends.
    ends-in: int,
    remaining-minutes: int,
    missing-minutes: int,
}

export struct WatchItem {
    channel-id: string,
    name: string,
    initial: string,
    avatar: image,
    game: string,
    title: string,
    viewers: int,
    // drops | streak | points | other
    reason: string,
    // Game for `drops`, raw reason for `other`.
    reason-detail: string,
    minutes: int,
}

export struct DropItem {
    game: string,
    campaign: string,
    reward: string,
    image: image,
    current: int,
    required: int,
    progress: float,
    // Minutes until the estimated end; -1 = unknown (not watching the target channel).
    eta-in: int,
    remaining-drops: int,
}

export struct TodayItem {
    points: int,
    minutes: int,
    drops: int,
}

// A point in time, in local time, for the views to phrase ("today at 18:00").
export struct When {
    // 0 = today, 1 = tomorrow, -1 = yesterday, other = see `date`.
    day-offset: int,
    // Local date (`24/10` in French, `10/24` in English) and time (`18:00`).
    date: string,
    time: string,
    known: bool,
}

// Results of the prediction bets, since the first one.
export struct PredictionSummary {
    bets: int,
    wins: int,
    losses: int,
    refunds: int,
    // Points won minus points bet.
    net: int,
}

// A reward of the inventory (received at least once).
export struct RewardItem {
    name: string,
    game: string,
    image: image,
    count: int,
    when: When,
}

export struct DropLine {
    name: string,
    current: int,
    required: int,
    progress: float,
    claimed: bool,
}

// One campaign of the drops plan (`module_data.drops.plan`), best first.
export struct PlanRow {
    campaign-id: string,
    campaign: string,
    game: string,
    image: image,
    // active | focus | restricted | planned | at_risk | will_miss | upcoming
    // | not_linked | skipped | done
    status: string,
    rewards: string,
    has-progress: bool,
    progress: float,
    remaining-minutes: int,
    missing-minutes: int,
    // planned: start; upcoming: campaign start; skipped: back at.
    when: When,
    eta: When,
    ends: When,
    link-url: string,
    details-url: string,
    // Channel names of a restricted campaign.
    channels: string,
    listed: bool,
    drops: [DropLine],
}

export struct ChannelItem {
    id: string,
    login: string,
    name: string,
    initial: string,
    avatar: image,
    live: bool,
    game: string,
    title: string,
    viewers: int,
    // Balance; `points-known` false = unknown ("—", not 0).
    points: int,
    points-known: bool,
    // "×1.2", empty when 1.
    multiplier: string,
    session-points: int,
    session-minutes: int,
    watching: bool,
    // Not tracked by the engine yet (just added, or unknown login).
    pending: bool,
    // In the `channels` setting: watched before the others when live.
    priority: bool,
    // Also in the never-mined list (`exclude`): the engine skips it.
    excluded: bool,
}

export struct ChartBar {
    label: string,
    value: int,
    // value / max, 0..1
    ratio: float,
}

// One history row (`history` command), phrased by the view from its kind.
export struct HistoryItem {
    id: int,
    // points_earned | points_spent | raid_joined | moment_claimed | prediction_placed
    // | prediction_result | watch_started | watch_stopped | drop_claimed | drop_alert
    // | account_status_changed | notice_raised | login_finished | other
    kind: string,
    when: When,
    channel: string,
    // Kind-specific values (see present.rs `history_item`).
    n: int,
    a: string,
    b: string,
    c: string,
}

// One setting of a form generated from a JSON Schema.
export struct FieldItem {
    // Module id, or `engine`.
    section: string,
    // Dotted path in the settings document (`alerts.at_risk`).
    path: string,
    // `<section>.<path>`, to look up a translated label.
    key: string,
    fallback-label: string,
    // Description from the schema (English).
    help: string,
    // bool | int | number | enum | text | list | json | group
    kind: string,
    depth: int,
    on: bool,
    text: string,
    selected: int,
    options: [SegmentItem],
    values: [string],
    // Differs from the default (shows "Rétablir").
    modified: bool,
}

export struct ModuleForm {
    id: string,
    name: string,
    description: string,
    enabled: bool,
    fields: [FieldItem],
}

// One `active_hours` window; `days` = Monday..Sunday.
export struct HourWindow {
    days: [bool],
    start: string,
    end: string,
}

export struct HealthItem {
    account: string,
    module: string,
    // disabled | running | stopped | restarting
    state: string,
    error: string,
}

export struct LogItem {
    time: string,
    level: string,
    target: string,
    message: string,
}

export struct UpdateInfo {
    checked: bool,
    available: bool,
    latest: string,
    url: string,
}

export struct GameItem {
    name: string,
    // Number of campaigns of this game in the plan.
    campaigns: int,
}

// Why nothing is watched, when watching is not allowed.
// disabled: the account is turned off; signed-out: it must sign in again;
// not-running: starting or in error (`idle-detail`: the error).
export enum Idle { none, paused, outside-hours, standby, disabled, signed-out, not-running }

export global Bridge {
    // Connection to the engine
    in property <Conn> conn: Conn.starting;
    in property <LinkState> link: LinkState.local;
    // Remote URL; when the link is down, why (`link-error`: the raw error).
    in property <string> link-detail;
    in property <Fault> link-fault;
    in property <string> link-error;
    // Setup screen: why it is shown (`setup-detail`: pid or raw error), pre-filled fields.
    in property <SetupReason> setup-reason;
    in property <string> setup-detail;
    in property <Fault> setup-fault;
    in property <string> setup-url;
    in property <string> setup-token;
    in property <bool> setup-can-cancel;
    in property <bool> connecting;

    // Engine data
    in property <[AccountItem]> accounts;
    in property <[LoginItem]> logins;
    in property <[NoticeItem]> notices;
    in property <[PlanTodo]> plan-todos;
    // Number of cards in the "À faire" zone.
    in property <int> todo-count;
    // Home (selected account)
    in property <[WatchItem]> watching;
    in property <bool> has-drop;
    in property <DropItem> drop;
    in property <TodayItem> today;
    in property <bool> paused;
    in property <Idle> idle;
    // Peer mining the account (standby).
    in property <string> idle-detail;
    // At least one followed channel is live (explains an empty "En ce moment").
    in property <bool> any-live;

    // Drops (selected account)
    in property <[PlanRow]> plan;
    // Results of the account's prediction bets (all zero: never bet).
    in property <PredictionSummary> predictions;
    // Rewards received (most recent first, at most `REWARDS_SHOWN`) and their total.
    in property <[RewardItem]> rewards;
    in property <int> rewards-total;
    in property <string> focus-id;
    in property <[GameItem]> games;
    in property <[string]> exclude-games;
    in property <[string]> wanted-rewards;
    // Games with campaigns that are neither listed nor excluded.
    in property <[string]> game-suggestions;
    in property <bool> drops-enabled;

    // Channels (selected account)
    // Channels of the points settings, in priority order.
    in property <[ChannelItem]> my-channels;
    // Every channel mined for points (priority and followed), for the main list.
    in property <[ChannelItem]> all-channels;
    in property <int> channels-live;
    // Display name of the selected account (whose balances are shown).
    in property <string> account-name;
    in property <int> channels-count;
    in property <int> channels-session-points;
    // engine.max_watch_slots: channels watched at once.
    in property <int> watch-slots: 2;
    in property <[string]> excluded-channels;
    in property <bool> follows;
    // 0 = my order, 1 = multiplier, 2 = fewest points, 3 = most points
    in property <int> points-order;
    in property <bool> points-enabled;

    // Activity (selected account). The view chooses; the controller queries.
    // 0 = points, 1 = minutes watched, 2 = drops
    in-out property <int> chart-metric;
    // 0 = per day, 1 = per channel
    in-out property <int> chart-group;
    // 7 or 30
    in-out property <int> chart-days: 30;
    in property <[ChartBar]> chart;
    in property <int> chart-total;
    // 0 = all, 1 = points, 2 = drops, 3 = watching, 4 = predictions & raids, 5 = account
    in-out property <int> history-filter;
    in property <[HistoryItem]> history;
    in property <bool> history-more;
    in property <bool> history-loading;

    // Settings (forms generated from the schemas)
    in property <[ModuleForm]> module-forms;
    in property <[FieldItem]> engine-main;
    in property <[FieldItem]> engine-network;
    in property <[FieldItem]> engine-peers;
    in property <[FieldItem]> engine-maintenance;
    in property <[HourWindow]> active-hours;
    in property <[HealthItem]> module-health;
    in property <bool> agent-enabled;
    // Agent token of the local engine (empty with a remote engine).
    in property <string> agent-token;
    in property <bool> local-engine;
    // API of the local engine: address it listens on (empty = off) and full token.
    in property <string> api-bind;
    // Why the local engine runs without its API (address busy or not available yet).
    in property <string> api-error;
    in property <string> api-token;
    in property <[LogItem]> logs;
    // Why the settings forms could not be loaded yet (retried; empty once loaded).
    in property <string> schemas-error;
    // Why the engine's log could not be read (empty when it was).
    in property <string> logs-error;
    in property <UpdateInfo> update-info;
    // Desktop: start with the session (when supported), closing hides to the tray.
    in property <bool> has-autostart;
    in property <bool> autostart;
    in property <bool> keeps-running;
    // Development (screenshots): unfold every folded section at start.
    in property <bool> dev-expand;

    in property <string> version;
    in property <int> manifest-revision;

    // Ephemeral feedback (command errors, confirmations)
    in property <[ToastItem]> toasts;

    // View state (never engine state)
    in-out property <Screen> screen: Screen.home;
    // Set before showing Settings to open its Advanced part (then reset by it).
    in-out property <bool> open-advanced;
    // Selected account id; empty = the only / first account.
    in-out property <string> account;
    in-out property <bool> login-busy;
    // 0 = French, 1 = English (interface preference).
    in-out property <int> language;

    callback select-account(string);
    callback login-start();
    callback login-cancel(string);
    callback open-url(string);
    callback connect-remote(string, string);
    callback use-local();
    callback show-setup();
    callback cancel-setup();
    callback dismiss-notice(string);
    callback dismiss-toast(int);
    callback set-account-enabled(string, bool);
    callback remove-account(string);
    callback theme-changed(int);
    callback language-changed(int);
    callback set-paused(bool);
    callback focus-campaign(string);
    callback unfocus();
    callback drops-refresh();
    callback drops-claim-all();
    // Edits of a list setting, `<module>.<key>`: drops.games, drops.exclude_games,
    // drops.wanted_rewards, points.channels, points.exclude.
    callback list-add(string, string);
    callback list-remove(string, string);
    callback list-move(string, int, int);
    // Sets one module setting: module, key, JSON value.
    callback set-module-setting(string, string, string);
    callback add-channel(string);
    // The activity choices changed (chart or filter): query again.
    callback activity-changed();
    callback history-load-more();
    // Settings edits: section (module id or `engine`), dotted path, value.
    callback setting-toggle(string, string, bool);
    callback setting-text(string, string, string);
    callback setting-pick(string, string, int);
    callback setting-list-add(string, string, string);
    callback setting-list-remove(string, string, string);
    callback setting-reset(string, string);
    callback hours-add();
    callback hours-remove(int);
    callback hours-toggle-day(int, int);
    callback hours-set(int, string, string);
    callback logs-refresh();
    // Serve the local engine's API (on, address); restarts the local engine.
    callback set-api(bool, string);
    callback update-check();
    callback manifest-refresh();
    callback backup();
    callback copy-text(string);
    callback set-autostart(bool);
    // A screen was opened (lets the controller load what it shows).
    callback screen-shown();
    callback remove-channel(string);
    // Never mine this channel again (exclude it, and drop it from the priorities).
    callback ignore-channel(string);
    // Autocomplete of game names: the view types, the controller fills `game-matches`.
    callback game-search(string);
    in property <[string]> game-matches;
}
