import { Theme } from "../theme.slint";
import { Bridge } from "../bridge.slint";
import { Button, Icon, IconButton, Icons, TextField } from "../widgets.slint";

// A removable list of short values, with an input to add one.
export component ValueList inherits VerticalLayout {
    in property <string> key;
    in property <[string]> values;
    in property <string> placeholder;
    // Propose game names while typing (Bridge.game-search / game-matches).
    in property <bool> suggest;
    property <string> draft;
    spacing: 6px;
    for v in root.values: Rectangle {
        height: 32px;
        border-radius: Theme.radius-m;
        background: Theme.inset;
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 4px;
            Text {
                text: v;
                color: Theme.text;
                font-size: Theme.font-s;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Icons.x;
                    size: 24px;
                    tooltip: @tr("Remove");
                    clicked => { Bridge.list-remove(root.key, v); }
                }
            }
        }
    }
    HorizontalLayout {
        spacing: 6px;
        field := TextField {
            height: 34px;
            placeholder: root.placeholder;
            text <=> root.draft;
            edited(t) => {
                if root.suggest { Bridge.game-search(t); }
            }
            accepted => {
                Bridge.list-add(root.key, root.draft);
                root.draft = "";
                if root.suggest { Bridge.game-search(""); }
            }
        }
        Button {
            compact: true;
            icon: Icons.plus;
            enabled: root.draft != "";
            clicked => {
                Bridge.list-add(root.key, root.draft);
                root.draft = "";
            }
        }
    }
    if root.suggest && root.draft != "" && Bridge.game-matches.length > 0: Rectangle {
        border-radius: Theme.radius-m;
        background: Theme.is-light ? #ffffff : #1d1b26;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000040;
        VerticalLayout {
            padding: 4px;
            for m in Bridge.game-matches: Rectangle {
                height: 32px;
                border-radius: Theme.radius-s;
                background: t.has-hover ? Theme.inset : transparent;
                accessible-role: button;
                accessible-label: m;
                accessible-action-default => { t.clicked(); }
                HorizontalLayout {
                    padding-left: 8px;
                    spacing: 8px;
                    Icon {
                        source: Icons.plus;
                        size: 14px;
                        colorize: Theme.accent;
                    }
                    Text {
                        text: m;
                        color: Theme.text;
                        font-size: Theme.font-s;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }
                t := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Bridge.list-add(root.key, m);
                        root.draft = "";
                        Bridge.game-search("");
                    }
                }
            }
        }
    }
}
