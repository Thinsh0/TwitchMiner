// The "À faire" zone: every action the user has to take, in one place.

import { Theme } from "../theme.slint";
import { Bridge, LoginItem, NoticeItem, AccountItem, PlanTodo, Screen } from "../bridge.slint";
import { Fmt } from "../fmt.slint";
import { Button, ButtonKind, Card, Icon, Icons, IconButton, Muted, Tone, Tones } from "../widgets.slint";

export component LoginCard inherits Card {
    in property <LoginItem> login;
    highlight: true;
    spacing: 14px;
    HorizontalLayout {
        spacing: 10px;
        Icon {
            source: Icons.user;
            colorize: Theme.accent;
        }
        Text {
            text: @tr("Connect a Twitch account");
            font-size: Theme.font-l;
            font-weight: 700;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
    Muted {
        text: @tr("Open the Twitch page and confirm this code (it is usually filled in already):");
        font-size: Theme.font-m;
    }
    HorizontalLayout {
        alignment: start;
        Rectangle {
            background: Theme.inset;
            border-radius: Theme.radius-m;
            border-width: 1px;
            border-color: Theme.border;
            HorizontalLayout {
                padding-left: 22px;
                padding-right: 22px;
                padding-top: 10px;
                padding-bottom: 10px;
                Text {
                    text: root.login.code;
                    font-size: 40px;
                    font-weight: 800;
                    letter-spacing: 6px;
                    color: Theme.text;
                    font-family: "Consolas";
                }
            }
        }
    }
    Muted {
        text: root.login.url;
    }
    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        Button {
            kind: ButtonKind.primary;
            icon: Icons.external;
            text: @tr("Open the Twitch page");
            clicked => { Bridge.open-url(root.login.link); }
        }
        Button {
            kind: ButtonKind.ghost;
            text: @tr("Cancel");
            clicked => { Bridge.login-cancel(root.login.flow-id); }
        }
        Text {
            text: @tr("Code valid until {}", root.login.expires-at);
            color: Theme.text-faint;
            font-size: Theme.font-s;
            vertical-alignment: center;
        }
    }
}

// One action card: icon, title, explanation, buttons on the right.
export component ActionCard inherits Card {
    in property <image> icon: Icons.alert;
    in property <Tone> tone: Tone.warning;
    in property <string> title;
    in property <string> body;
    in property <bool> closable;
    callback close();
    inner-padding: 14px;
    HorizontalLayout {
        spacing: 12px;
        Rectangle {
            width: 34px;
            height: 34px;
            border-radius: Theme.radius-m;
            background: Tones.bg(root.tone);
            Icon {
                source: root.icon;
                colorize: Tones.fg(root.tone);
            }
        }
        VerticalLayout {
            spacing: 3px;
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                font-weight: 600;
                color: Theme.text;
                wrap: word-wrap;
            }
            if root.body != "": Muted {
                text: root.body;
            }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: 8px;
                    @children
                }
            }
            if root.closable: VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Icons.x;
                    tooltip: @tr("Dismiss");
                    clicked => { root.close(); }
                }
            }
        }
    }
}

export component AuthCard inherits ActionCard {
    in property <AccountItem> account;
    icon: Icons.user;
    tone: Tone.danger;
    title: @tr("{} must sign in again", account.name);
    body: @tr("Twitch no longer accepts this account's session. Nothing is mined for it until you reconnect.");
    Button {
        kind: ButtonKind.primary;
        text: @tr("Reconnect");
        busy: Bridge.login-busy;
        clicked => { Bridge.login-start(); }
    }
}

// An engine notice: text and action built from its kind, English message otherwise.
export component NoticeCard inherits ActionCard {
    in property <NoticeItem> notice;
    icon: notice.level == "info" ? Icons.info : Icons.alert;
    tone: notice.level == "error" ? Tone.danger : notice.level == "warning" ? Tone.warning : Tone.info;
    title: notice.kind == "update" ? @tr("TwitchMiner {} is available", notice.version)
        : notice.kind == "duplicate" ? @tr("{} is mined twice", notice.login)
        : notice.kind == "proxy_invalid" ? @tr("The proxy cannot be used")
        : notice.kind == "realtime_down" ? @tr("Real-time updates are down for {}", notice.login)
        : notice.message;
    body: notice.kind == "update" ? @tr("You have version {}.", notice.current)
        : notice.kind == "duplicate" ? @tr("{} mines it too. Set one of the two engines to secondary (Settings › Advanced › Several devices): it will leave the account to the other.", notice.peer)
        : notice.kind == "proxy_invalid" ? @tr("Nothing goes through it until it is fixed: {}", notice.error)
        : notice.kind == "realtime_down" ? @tr("Twitch PubSub has been unreachable for 10 minutes. Drops and points keep progressing; raids, moments and predictions wait for the connection.")
        : "";
    closable: true;
    close => { Bridge.dismiss-notice(root.notice.id); }
    if root.notice.kind == "update" && root.notice.url != "": Button {
        kind: ButtonKind.primary;
        icon: Icons.external;
        text: @tr("Download");
        clicked => { Bridge.open-url(root.notice.url); }
    }
    if root.notice.kind == "duplicate" || root.notice.kind == "proxy_invalid": Button {
        text: @tr("Open settings");
        clicked => {
            Bridge.open-advanced = true;
            Bridge.screen = Screen.settings;
        }
    }
}

// A plan entry that needs the user: link the game account, or decide to do it first.
export component PlanTodoCard inherits ActionCard {
    in property <PlanTodo> todo;
    property <string> goal: todo.rewards == "" ? "" : "\n" + @tr("Goal: {}", todo.rewards);
    icon: todo.kind == "not_linked" ? Icons.link : todo.kind == "at_risk" ? Icons.clock : Icons.alert;
    tone: todo.kind == "will_miss" ? Tone.danger : todo.kind == "at_risk" ? Tone.warning : Tone.info;
    title: todo.kind == "not_linked" ? @tr("Link your {} account", todo.game)
        : todo.kind == "at_risk" ? @tr("{} may not finish in time", todo.game)
        : @tr("{} will not be finished", todo.game);
    body: (todo.kind == "not_linked"
        ? @tr("The campaign “{}” only gives its rewards to accounts linked to the game.", todo.campaign)
        : todo.kind == "at_risk"
        ? @tr("About {} of watching left, and it ends in {}. Doing it first secures it.", Fmt.duration(todo.remaining-minutes), Fmt.duration(todo.ends-in))
        : @tr("About {} would be missing when it ends (in {}). Doing it first gets it, at the expense of the next ones.", Fmt.duration(todo.missing-minutes), Fmt.duration(todo.ends-in)))
        + goal;
    if root.todo.kind == "not_linked" && root.todo.link-url != "": Button {
        kind: ButtonKind.primary;
        icon: Icons.external;
        text: @tr("Link my account");
        clicked => { Bridge.open-url(root.todo.link-url); }
    }
    if root.todo.kind != "not_linked": Button {
        kind: ButtonKind.primary;
        icon: Icons.star;
        text: @tr("Do it first");
        clicked => { Bridge.focus-campaign(root.todo.campaign-id); }
    }
}

export component TodoZone inherits VerticalLayout {
    spacing: 10px;
    for login in Bridge.logins: LoginCard {
        login: login;
    }
    for acc in Bridge.accounts: VerticalLayout {
        if acc.status == "auth_required" && Bridge.logins.length == 0: AuthCard {
            account: acc;
        }
    }
    for todo in Bridge.plan-todos: PlanTodoCard {
        todo: todo;
    }
    for notice in Bridge.notices: NoticeCard {
        notice: notice;
    }
}
