// Number and duration formatting, in the interface language.

import { Bridge, Fault, LinkState } from "bridge.slint";

export global Fmt {
    // 45 min · 2 h 05 min · 3 d 4 h
    pure public function duration(m: int) -> string {
        if m < 60 {
            return @tr("{} min", max(m, 0));
        }
        if m < 1440 {
            if mod(m, 60) == 0 {
                return @tr("{} h", floor(m / 60));
            }
            return @tr("{} h {} min", floor(m / 60), pad2(mod(m, 60)));
        }
        if mod(m, 1440) < 60 {
            return @tr("{} d", floor(m / 1440));
        }
        return @tr("{} d {} h", floor(m / 1440), floor(mod(m, 1440) / 60));
    }

    // What to do about an unreachable remote engine.
    pure public function fault(f: Fault, raw: string) -> string {
        return f == Fault.not-https ? @tr("this server does not use HTTPS: write the address with http:// (Tailscale already encrypts the connection)")
            : f == Fault.bad-token ? @tr("the token was refused. Copy it again from the server: twitchminer api-token")
            : f == Fault.refused ? @tr("nothing answers on this port. Is the engine running, and is the port right (7878 by default)?")
            : f == Fault.unknown-host ? @tr("unknown address. Check the name, and that Tailscale (or your VPN) is connected on this device.")
            : f == Fault.no-answer ? @tr("no answer. Check that the server is on and reachable from this network (Tailscale connected?).")
            : f == Fault.bad-url ? @tr("invalid address ({}). Example: http://192.168.1.10:7878", raw)
            : raw;
    }

    // Remote URL, followed by the reason when the link is down.
    pure public function link-detail() -> string {
        return Bridge.link == LinkState.down && Bridge.link-fault != Fault.none
            ? Bridge.link-detail + " · " + fault(Bridge.link-fault, Bridge.link-error)
            : Bridge.link-detail;
    }

    // 12 345 (French) · 12,345 (English)
    pure public function int(n: int) -> string {
        let a = abs(n);
        let sign = n < 0 ? "-" : "";
        let sep = Bridge.language == 1 ? "," : " ";
        if a < 1000 {
            return sign + a;
        }
        if a < 1000000 {
            return sign + floor(a / 1000) + sep + pad3(mod(a, 1000));
        }
        return sign + floor(a / 1000000) + sep + pad3(mod(floor(a / 1000), 1000)) + sep + pad3(mod(a, 1000));
    }

    pure function pad2(x: int) -> string {
        return x < 10 ? "0" + x : "" + x;
    }

    pure function pad3(x: int) -> string {
        return x < 10 ? "00" + x : x < 100 ? "0" + x : "" + x;
    }
}
