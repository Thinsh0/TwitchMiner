import { AboutSlint } from "std-widgets.slint";
import { Theme, ThemeMode } from "../theme.slint";
import { Bridge, AccountItem, FieldItem, LinkState, Screen, HourWindow } from "../bridge.slint";
import { Avatar, Button, ButtonKind, Card, Icon, IconButton, Icons, Muted, Page, Pill, Segmented, SegmentItem, TextField, Toggle, Tone } from "../widgets.slint";
import { FieldList } from "fields.slint";
import { SettingText } from "setting_text.slint";

export global Labels {
    pure public function account-status(s: string) -> string {
        if s == "running" { return @tr("Active"); }
        if s == "starting" { return @tr("Starting"); }
        if s == "auth_required" { return @tr("Sign-in required"); }
        if s == "error" { return @tr("Error"); }
        if s == "standby" { return @tr("Handled by another device"); }
        return @tr("Stopped");
    }
    pure public function account-tone(s: string) -> Tone {
        if s == "running" { return Tone.success; }
        if s == "starting" { return Tone.info; }
        if s == "auth_required" || s == "error" { return Tone.danger; }
        if s == "standby" { return Tone.accent; }
        return Tone.neutral;
    }
    pure public function health(s: string) -> string {
        if s == "running" { return @tr("on"); }
        if s == "restarting" { return @tr("restarting"); }
        if s == "stopped" { return @tr("stopped"); }
        return @tr("off");
    }
    pure public function health-tone(s: string) -> Tone {
        if s == "running" { return Tone.success; }
        if s == "restarting" { return Tone.danger; }
        return Tone.neutral;
    }
}

component SectionTitle inherits Text {
    font-size: Theme.font-l;
    font-weight: 700;
    color: Theme.text;
}

component SettingRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> help;
    spacing: 16px;
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        horizontal-stretch: 1;
        Text {
            text: root.label;
            color: Theme.text;
            font-weight: 600;
        }
        if root.help != "": Muted {
            text: root.help;
        }
    }
    VerticalLayout {
        alignment: center;
        @children
    }
}

// A secret shown masked, with "show" and "copy".
component SecretRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> secret;
    property <bool> shown;
    spacing: 8px;
    Text {
        text: root.label;
        color: Theme.text;
        font-weight: 600;
        vertical-alignment: center;
    }
    Rectangle {
        horizontal-stretch: 1;
        height: 32px;
        border-radius: Theme.radius-m;
        background: Theme.inset;
        clip: true;
        Text {
            x: 10px;
            width: parent.width - 20px;
            text: root.shown ? root.secret : "••••••••••••••••••••";
            font-family: "Consolas";
            font-size: Theme.font-s;
            color: Theme.text-muted;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    Button {
        compact: true;
        kind: ButtonKind.ghost;
        text: root.shown ? @tr("Hide") : @tr("Show");
        clicked => { root.shown = !root.shown; }
    }
    Button {
        compact: true;
        icon: Icons.copy;
        text: @tr("Copy");
        clicked => { Bridge.copy-text(root.secret); }
    }
}

component AccountRow inherits Rectangle {
    in property <AccountItem> account;
    property <bool> confirm;
    min-height: 56px;
    border-radius: Theme.radius-m;
    background: Theme.inset;
    HorizontalLayout {
        padding: 10px;
        padding-left: 12px;
        spacing: 12px;
        Avatar {
            source: root.account.avatar;
            initial: root.account.initial;
            size: 36px;
        }
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Text {
                    text: root.account.name;
                    font-weight: 600;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                Pill {
                    text: Labels.account-status(root.account.status);
                    tone: Labels.account-tone(root.account.status);
                }
            }
            Muted {
                text: root.account.status == "standby" ? @tr("Mined by {}", root.account.detail)
                    : root.account.detail != "" ? root.account.detail : "@" + root.account.login;
            }
            // Health of each module for this account.
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                for h in Bridge.module-health: HorizontalLayout {
                    if h.account == root.account.id: Pill {
                        text: SettingText.module-name(h.module, h.module) + " · " + Labels.health(h.state);
                        tone: Labels.health-tone(h.state);
                    }
                }
            }
        }
        if !root.confirm: HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                Toggle {
                    checked: root.account.enabled;
                    toggled(v) => { Bridge.set-account-enabled(root.account.id, v); }
                }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Icons.trash;
                    tooltip: @tr("Remove this account");
                    clicked => { root.confirm = true; }
                }
            }
        }
        if root.confirm: HorizontalLayout {
            spacing: 8px;
            Muted {
                text: @tr("Remove this account from TwitchMiner?");
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                Button {
                    kind: ButtonKind.danger;
                    compact: true;
                    text: @tr("Remove");
                    clicked => {
                        root.confirm = false;
                        Bridge.remove-account(root.account.id);
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                Button {
                    kind: ButtonKind.ghost;
                    compact: true;
                    text: @tr("Cancel");
                    clicked => { root.confirm = false; }
                }
            }
        }
    }
}

// One module: on/off in the header, its options folded.
component ModuleCard inherits Card {
    in property <string> id;
    in property <string> name;
    in property <string> description;
    in property <bool> enabled;
    in property <[FieldItem]> fields;
    property <bool> open: Bridge.dev-expand;
    HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            spacing: 2px;
            horizontal-stretch: 1;
            SectionTitle {
                text: SettingText.module-name(root.id, root.name);
            }
            Muted {
                text: SettingText.module-description(root.id, root.description);
            }
        }
        if root.fields.length > 0: VerticalLayout {
            alignment: center;
            Button {
                compact: true;
                kind: ButtonKind.ghost;
                icon: root.open ? Icons.chevron-down : Icons.chevron-right;
                text: @tr("Options");
                clicked => { root.open = !root.open; }
            }
        }
        VerticalLayout {
            alignment: center;
            Toggle {
                checked: root.enabled;
                toggled(v) => { Bridge.setting-toggle(root.id, "enabled", v); }
            }
        }
    }
    if root.open: Rectangle {
        height: 1px;
        background: Theme.border;
    }
    if root.open: FieldList {
        fields: root.fields;
    }
}


component HoursRow inherits Rectangle {
    in property <int> index;
    in property <HourWindow> window;
    property <string> start: window.start;
    property <string> end: window.end;
    height: 44px;
    border-radius: Theme.radius-m;
    background: Theme.inset;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 4px;
        spacing: 4px;
        for on[d] in root.window.days: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 30px;
                height: 28px;
                border-radius: Theme.radius-s;
                background: on ? Theme.accent-strong : t.has-hover ? Theme.card-hover : transparent;
                border-width: 1px;
                border-color: on ? Theme.accent-strong : Theme.border;
                accessible-role: checkbox;
                accessible-checkable: true;
                accessible-checked: on;
                accessible-label: d == 0 ? @tr("Monday") : d == 1 ? @tr("Tuesday") : d == 2 ? @tr("Wednesday") : d == 3 ? @tr("Thursday") : d == 4 ? @tr("Friday") : d == 5 ? @tr("Saturday") : @tr("Sunday");
                accessible-action-default => { Bridge.hours-toggle-day(root.index, d); }
                Text {
                    text: d == 0 ? @tr("Mo") : d == 1 ? @tr("Tu") : d == 2 ? @tr("We") : d == 3 ? @tr("Th") : d == 4 ? @tr("Fr") : d == 5 ? @tr("Sa") : @tr("Su");
                    font-size: Theme.font-xs;
                    font-weight: 600;
                    color: on ? Theme.on-accent : Theme.text-muted;
                }
                t := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Bridge.hours-toggle-day(root.index, d); }
                }
            }
        }
        Rectangle {
            width: 10px;
        }
        VerticalLayout {
            alignment: center;
            TextField {
                width: 70px;
                height: 30px;
                text <=> root.start;
                accepted => { Bridge.hours-set(root.index, root.start, root.end); }
            }
        }
        Text {
            text: "→";
            color: Theme.text-faint;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            TextField {
                width: 70px;
                height: 30px;
                text <=> root.end;
                accepted => { Bridge.hours-set(root.index, root.start, root.end); }
            }
        }
        VerticalLayout {
            alignment: center;
            Button {
                compact: true;
                kind: ButtonKind.ghost;
                text: @tr("Apply");
                enabled: root.start != root.window.start || root.end != root.window.end;
                clicked => { Bridge.hours-set(root.index, root.start, root.end); }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.trash;
                tooltip: @tr("Remove this time slot");
                clicked => { Bridge.hours-remove(root.index); }
            }
        }
    }
}

// `active_hours`: watching only happens inside these windows (empty = always).
component HoursEditor inherits VerticalLayout {
    spacing: 8px;
    for w[i] in Bridge.active-hours: HoursRow {
        index: i;
        window: w;
    }
    HorizontalLayout {
        alignment: start;
        Button {
            compact: true;
            icon: Icons.plus;
            text: @tr("Add a time slot");
            clicked => { Bridge.hours-add(); }
        }
    }
}

// Serving the local engine's API: control from a phone or another PC, AI agents.
component ApiAccess inherits VerticalLayout {
    property <string> bind: Bridge.api-bind == "" ? "127.0.0.1:7878" : Bridge.api-bind;
    spacing: 10px;
    Rectangle {
        height: 1px;
        background: Theme.border;
    }
    HorizontalLayout {
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: @tr("Remote access (API)");
                color: Theme.text;
                font-weight: 600;
            }
            Muted {
                text: @tr("Lets a phone, another PC or an AI agent connect to this engine. 127.0.0.1 = this computer only; use your local or Tailscale address to open it to other devices. Restarts the engine.");
            }
        }
        VerticalLayout {
            alignment: center;
            Toggle {
                checked: Bridge.api-bind != "";
                toggled(v) => { Bridge.set-api(v, root.bind); }
            }
        }
    }
    HorizontalLayout {
        spacing: 8px;
        Text {
            text: @tr("Address");
            color: Theme.text;
            font-weight: 600;
            vertical-alignment: center;
        }
        TextField {
            height: 32px;
            text <=> root.bind;
            accepted => { Bridge.set-api(true, root.bind); }
        }
        Button {
            compact: true;
            text: @tr("Apply");
            enabled: root.bind != Bridge.api-bind;
            clicked => { Bridge.set-api(true, root.bind); }
        }
    }
    if Bridge.api-bind != "": SecretRow {
        label: @tr("API token");
        secret: Bridge.api-token;
    }
}

component LogView inherits VerticalLayout {
    spacing: 8px;
    HorizontalLayout {
        spacing: 8px;
        Muted {
            text: Bridge.logs-available ? @tr("Most recent first.") : @tr("The log of a remote engine is on the machine running it.");
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if Bridge.logs-available: Button {
            compact: true;
            kind: ButtonKind.ghost;
            icon: Icons.refresh;
            text: @tr("Refresh");
            clicked => { Bridge.logs-refresh(); }
        }
    }
    if Bridge.logs-available: Rectangle {
        height: 260px;
        border-radius: Theme.radius-m;
        background: Theme.inset;
        clip: true;
        Flickable {
            content-height: lines.preferred-height;
            lines := VerticalLayout {
                padding: 10px;
                spacing: 3px;
                for l in Bridge.logs: HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: l.time;
                        font-family: "Consolas";
                        font-size: Theme.font-xs;
                        color: Theme.text-faint;
                    }
                    Text {
                        text: l.level;
                        width: 40px;
                        font-family: "Consolas";
                        font-size: Theme.font-xs;
                        color: l.level == "error" ? Theme.danger : l.level == "warn" ? Theme.warning : Theme.text-faint;
                    }
                    Text {
                        text: l.message;
                        font-family: "Consolas";
                        font-size: Theme.font-xs;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }
            }
        }
    }
}

export component SettingsScreen inherits Page {
    title: @tr("Settings");
    property <bool> advanced: Bridge.dev-expand;

    Card {
        SectionTitle {
            text: @tr("Appearance");
        }
        SettingRow {
            label: @tr("Theme");
            help: @tr("OLED uses pure black, to save battery on OLED screens.");
            Segmented {
                width: 260px;
                items: [
                    { label: @tr("Dark") },
                    { label: @tr("Light") },
                    { label: @tr("OLED") },
                ];
                selected: Theme.mode == ThemeMode.light ? 1 : Theme.mode == ThemeMode.oled ? 2 : 0;
                picked(i) => {
                    Theme.mode = i == 1 ? ThemeMode.light : i == 2 ? ThemeMode.oled : ThemeMode.dark;
                    Bridge.theme-changed(i);
                }
            }
        }
        SettingRow {
            label: @tr("Language");
            // Language names are written in their own language.
            Segmented {
                width: 260px;
                items: [{ label: "Français" }, { label: "English" }];
                selected: Bridge.language;
                picked(i) => { Bridge.language-changed(i); }
            }
        }
    }

    Card {
        HorizontalLayout {
            SectionTitle {
                text: @tr("Accounts");
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Button {
                compact: true;
                icon: Icons.plus;
                text: @tr("Add an account");
                busy: Bridge.login-busy;
                clicked => {
                    Bridge.login-start();
                    Bridge.screen = Screen.home;
                }
            }
        }
        if Bridge.accounts.length == 0: Muted {
            text: @tr("No account yet.");
        }
        for acc in Bridge.accounts: AccountRow {
            account: acc;
        }
    }

    for m in Bridge.module-forms: ModuleCard {
        id: m.id;
        name: m.name;
        description: m.description;
        enabled: m.enabled;
        fields: m.fields;
    }

    Card {
        SectionTitle {
            text: @tr("Watching");
        }
        FieldList {
            fields: Bridge.engine-main;
        }
        Text {
            text: @tr("Time slots");
            color: Theme.text;
            font-weight: 600;
        }
        Muted {
            text: Bridge.active-hours.length == 0 ? @tr("No time slot: watching at any time. Add one to watch only at certain times (local time; an end before the start goes past midnight).")
                : @tr("Watching only inside these slots (local time; an end before the start goes past midnight). Enter the times as HH:MM.");
        }
        HoursEditor { }
    }

    // Advanced, folded by default.
    Rectangle {
        height: 36px;
        accessible-role: button;
        accessible-label: @tr("Advanced");
        accessible-expandable: true;
        accessible-expanded: root.advanced;
        accessible-action-default => { root.advanced = !root.advanced; }
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            Icon {
                source: root.advanced ? Icons.chevron-down : Icons.chevron-right;
                size: 16px;
            }
            Text {
                text: @tr("Advanced");
                color: Theme.text-muted;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.advanced = !root.advanced; }
        }
    }

    if root.advanced: Card {
        SectionTitle {
            text: @tr("Engine");
        }
        SettingRow {
            label: Bridge.link == LinkState.local ? @tr("On this computer") : @tr("Remote server");
            help: Bridge.link == LinkState.local
                ? @tr("The engine runs inside this application.")
                : Bridge.link-detail;
            Button {
                compact: true;
                icon: Icons.server;
                text: @tr("Change…");
                clicked => { Bridge.show-setup(); }
            }
        }
    }

    if root.advanced: Card {
        SectionTitle {
            text: @tr("Network");
        }
        FieldList {
            fields: Bridge.engine-network;
        }
        if Bridge.local-engine: ApiAccess { }
    }

    if root.advanced: Card {
        SectionTitle {
            text: @tr("Several devices");
        }
        Muted {
            text: @tr("A home server can mine while this device stays on standby, and take over if it stops.");
        }
        FieldList {
            fields: Bridge.engine-peers;
        }
    }

    if root.advanced: Card {
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 1;
                SectionTitle {
                    text: @tr("AI agent");
                }
                Muted {
                    text: @tr("Lets an AI agent (MCP) follow and drive TwitchMiner with a restricted token: no deletions, no files, secrets hidden.");
                }
            }
            VerticalLayout {
                alignment: center;
                Toggle {
                    checked: Bridge.agent-enabled;
                    toggled(v) => { Bridge.setting-toggle("engine", "agent_enabled", v); }
                }
            }
        }
        if Bridge.agent-enabled && Bridge.agent-token != "": SecretRow {
            label: @tr("Agent token");
            secret: Bridge.agent-token;
        }
        if Bridge.agent-enabled && Bridge.agent-token == "": Muted {
            text: @tr("The agent token of a remote engine is shown on its machine: twitchminer api-token --agent");
        }
    }

    if root.advanced: Card {
        SectionTitle {
            text: @tr("Maintenance");
        }
        FieldList {
            fields: Bridge.engine-maintenance;
        }
    }

    if root.advanced: Card {
        SectionTitle {
            text: @tr("Log");
        }
        LogView { }
    }

    if root.advanced: Card {
        SectionTitle {
            text: @tr("About");
        }
        Muted {
            text: "TwitchMiner " + Bridge.version + " · " + @tr("Twitch identifiers revision {}", Bridge.manifest-revision);
        }
        if Bridge.update-info.checked: Muted {
            text: Bridge.update-info.available ? @tr("Version {} is available.", Bridge.update-info.latest) : @tr("TwitchMiner is up to date.");
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Button {
                compact: true;
                icon: Icons.refresh;
                text: @tr("Check for updates");
                clicked => { Bridge.update-check(); }
            }
            if Bridge.update-info.available && Bridge.update-info.url != "": Button {
                compact: true;
                kind: ButtonKind.primary;
                icon: Icons.external;
                text: @tr("Download");
                clicked => { Bridge.open-url(Bridge.update-info.url); }
            }
            Button {
                compact: true;
                text: @tr("Update Twitch identifiers");
                clicked => { Bridge.manifest-refresh(); }
            }
            Button {
                compact: true;
                text: @tr("Back up the database");
                clicked => { Bridge.backup(); }
            }
        }
        AboutSlint {
            max-height: 120px;
        }
    }
}
