import { AboutSlint, ListView } from "std-widgets.slint";
import { Theme, ThemeMode } from "../theme.slint";
import { Bridge, AccountItem, FieldItem, LinkState, Screen, HourWindow, NotifyEvent, NotifyTarget, UpdatePhase } from "../bridge.slint";
import { Avatar, Button, ButtonKind, Card, Icon, IconButton, Icons, Muted, Page, Pill, Segmented, SegmentItem, TextField, Toggle, Tone } from "../widgets.slint";
import { FieldList } from "fields.slint";
import { SettingText } from "setting_text.slint";
import { Fmt } from "../fmt.slint";

export global Labels {
    pure public function account-status(s: string) -> string {
        if s == "running" { return @tr("Active"); }
        if s == "starting" { return @tr("Starting"); }
        if s == "auth_required" { return @tr("Sign-in required"); }
        if s == "error" { return @tr("Error"); }
        if s == "standby" { return @tr("Handled by another device"); }
        return @tr("Stopped");
    }
    pure public function account-tone(s: string) -> Tone {
        if s == "running" { return Tone.success; }
        if s == "starting" { return Tone.info; }
        if s == "auth_required" || s == "error" { return Tone.danger; }
        if s == "standby" { return Tone.accent; }
        return Tone.neutral;
    }
    pure public function health(s: string) -> string {
        if s == "running" { return @tr("on"); }
        if s == "restarting" { return @tr("restarting"); }
        if s == "stopped" { return @tr("stopped"); }
        return @tr("off");
    }
    pure public function health-tone(s: string) -> Tone {
        if s == "running" { return Tone.success; }
        if s == "restarting" { return Tone.danger; }
        return Tone.neutral;
    }
}

component SectionTitle inherits Text {
    font-size: Theme.font-l;
    font-weight: 700;
    color: Theme.text;
}

// Label and help on the left, the control on the right (under them when `stack`).
component SettingRow inherits GridLayout {
    in property <string> label;
    in property <string> help;
    in property <bool> stack: Theme.compact;
    spacing-horizontal: 16px;
    spacing-vertical: 8px;
    VerticalLayout {
        row: 0;
        col: 0;
        alignment: center;
        spacing: 2px;
        horizontal-stretch: 1;
        Text {
            text: root.label;
            color: Theme.text;
            font-weight: 600;
        }
        if root.help != "": Muted {
            text: root.help;
        }
    }
    HorizontalLayout {
        row: root.stack ? 1 : 0;
        col: root.stack ? 0 : 1;
        alignment: root.stack ? start : end;
        VerticalLayout {
            alignment: center;
            @children
        }
    }
}

// A secret shown masked, with "show" and "copy".
component SecretRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> secret;
    property <bool> shown;
    spacing: 8px;
    Text {
        text: root.label;
        color: Theme.text;
        font-weight: 600;
        vertical-alignment: center;
    }
    Rectangle {
        horizontal-stretch: 1;
        height: 32px;
        border-radius: Theme.radius-m;
        background: Theme.inset;
        clip: true;
        Text {
            x: 10px;
            width: parent.width - 20px;
            text: root.shown ? root.secret : "••••••••••••••••••••";
            font-family: "Consolas";
            font-size: Theme.font-s;
            color: Theme.text-muted;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    Button {
        compact: true;
        kind: ButtonKind.ghost;
        text: root.shown ? @tr("Hide") : @tr("Show");
        clicked => { root.shown = !root.shown; }
    }
    Button {
        compact: true;
        icon: Icons.copy;
        text: @tr("Copy");
        clicked => { Bridge.copy-text(root.secret); }
    }
}

component AccountRow inherits Rectangle {
    in property <AccountItem> account;
    property <bool> confirm;
    min-height: 56px;
    border-radius: Theme.radius-m;
    background: Theme.inset;
    HorizontalLayout {
        padding: 10px;
        padding-left: 12px;
        spacing: 12px;
        Avatar {
            source: root.account.avatar;
            initial: root.account.initial;
            size: 36px;
        }
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Text {
                    text: root.account.name;
                    font-weight: 600;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                Pill {
                    text: Labels.account-status(root.account.status);
                    tone: Labels.account-tone(root.account.status);
                }
                if root.account.guest != "": Pill {
                    text: @tr("Guest: {}", root.account.guest);
                    tone: Tone.accent;
                    icon: Icons.user;
                }
            }
            Muted {
                text: root.account.status == "standby" ? @tr("Mined by {}", root.account.detail)
                    : root.account.detail != "" ? root.account.detail : "@" + root.account.login;
            }
            // Health of each module for this account (too wide for a compact layout).
            if !Theme.compact: HorizontalLayout {
                spacing: 6px;
                alignment: start;
                for h in Bridge.module-health: HorizontalLayout {
                    if h.account == root.account.id: Pill {
                        text: SettingText.module-name(h.module, h.module) + " · " + Labels.health(h.state);
                        tone: Labels.health-tone(h.state);
                    }
                }
            }
        }
        if !root.confirm: HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                Toggle {
                    checked: root.account.enabled;
                    toggled(v) => { Bridge.set-account-enabled(root.account.id, v); }
                }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Icons.trash;
                    tooltip: @tr("Remove this account");
                    clicked => { root.confirm = true; }
                }
            }
        }
        if root.confirm: HorizontalLayout {
            spacing: 8px;
            Muted {
                text: @tr("Remove this account from TwitchMiner?");
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                Button {
                    kind: ButtonKind.danger;
                    compact: true;
                    text: @tr("Remove");
                    clicked => {
                        root.confirm = false;
                        Bridge.remove-account(root.account.id);
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                Button {
                    kind: ButtonKind.ghost;
                    compact: true;
                    text: @tr("Cancel");
                    clicked => { root.confirm = false; }
                }
            }
        }
    }
}

// Notifications: where they go and what is sent, without writing JSON.
component NotifyEditor inherits VerticalLayout {
    // ntfy, discord, telegram, webhook
    property <int> kind;
    property <string> value;
    property <string> chat;
    property <string> kind-id: kind == 0 ? "ntfy" : kind == 1 ? "discord" : kind == 2 ? "telegram" : "webhook";
    spacing: 10px;

    pure function event-label(key: string) -> string {
        if key == "drop_claimed" { return @tr("Drop claimed"); }
        if key == "drop_alert" { return @tr("Drop alerts (tight, will be missed, game account to link, new campaign)"); }
        if key == "auth_required" { return @tr("Account must sign in again"); }
        if key == "notice_raised" { return @tr("Engine warnings (update available, proxy, mined twice…)"); }
        if key == "prediction_result" { return @tr("Prediction results"); }
        if key == "prediction_placed" { return @tr("Prediction bets placed"); }
        if key == "points_earned" { return @tr("Points earned (each gain: many messages)"); }
        if key == "raid_joined" { return @tr("Raids joined"); }
        if key == "watch_started" { return @tr("Watching started on a channel"); }
        return key;
    }

    function add() {
        Bridge.notify-add(root.kind-id, root.value, root.chat);
        root.value = "";
        root.chat = "";
    }

    Text {
        text: @tr("Destinations");
        color: Theme.text;
        font-weight: 600;
    }
    if Bridge.notify-targets.length == 0: Muted {
        text: @tr("None yet: nothing is sent.");
    }
    for t[i] in Bridge.notify-targets: Rectangle {
        height: 38px;
        border-radius: Theme.radius-m;
        background: Theme.inset;
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 4px;
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                Pill {
                    text: t.kind == "ntfy" ? "ntfy" : t.kind == "discord" ? "Discord" : t.kind == "telegram" ? "Telegram" : "Webhook";
                    tone: Tone.accent;
                }
            }
            Text {
                text: t.label;
                font-size: Theme.font-s;
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            // On the phone: subscribe in the ntfy app in one tap.
            if Bridge.on-phone && t.subscribe != "": VerticalLayout {
                alignment: center;
                Button {
                    compact: true;
                    kind: ButtonKind.ghost;
                    icon: Icons.external;
                    text: @tr("Subscribe in ntfy");
                    clicked => { Bridge.open-url(t.subscribe); }
                }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Icons.trash;
                    tooltip: @tr("Remove");
                    clicked => { Bridge.notify-remove(i); }
                }
            }
        }
    }

    Rectangle {
        border-radius: Theme.radius-m;
        border-width: 1px;
        border-color: Theme.border;
        VerticalLayout {
            padding: 10px;
            spacing: 8px;
            Segmented {
                items: [{ label: "ntfy" }, { label: "Discord" }, { label: "Telegram" }, { label: "Webhook" }];
                selected: root.kind;
                picked(i) => {
                    root.kind = i;
                    root.value = "";
                    root.chat = "";
                }
            }
            Muted {
                text: root.kind == 0 ? (Bridge.on-phone
                        ? @tr("Install the ntfy app (Play Store), then here: Generate, Add, and “Subscribe in ntfy”. Anyone who knows the topic can read the messages.")
                        : @tr("Phone: install the ntfy app (Play Store), subscribe to a hard-to-guess topic, and add the same topic here. Anyone who knows the topic can read the messages."))
                    : root.kind == 1 ? @tr("Discord: channel settings › Integrations › Webhooks › New webhook › Copy webhook URL.")
                    : root.kind == 2 ? @tr("Telegram: the token given by @BotFather, and your chat id (send a message to the bot first).")
                    : @tr("Any URL that receives a JSON POST with the text and the event.");
            }
            HorizontalLayout {
                spacing: 6px;
                TextField {
                    placeholder: root.kind == 0 ? @tr("Topic, or https://your-server/topic")
                        : root.kind == 1 ? "https://discord.com/api/webhooks/…"
                        : root.kind == 2 ? @tr("Bot token") : "https://…";
                    text <=> root.value;
                    accepted => { root.add(); }
                }
                if root.kind == 0: Button {
                    compact: true;
                    kind: ButtonKind.ghost;
                    icon: Icons.refresh;
                    text: @tr("Generate");
                    clicked => { root.value = Bridge.notify-random-topic(); }
                }
            }
            if root.kind == 2: TextField {
                placeholder: @tr("Chat id");
                text <=> root.chat;
                accepted => { root.add(); }
            }
            HorizontalLayout {
                alignment: start;
                Button {
                    compact: true;
                    kind: ButtonKind.primary;
                    icon: Icons.plus;
                    text: @tr("Add");
                    enabled: root.value != "" && (root.kind != 2 || root.chat != "");
                    clicked => { root.add(); }
                }
            }
        }
    }
    HorizontalLayout {
        alignment: start;
        Button {
            compact: true;
            text: @tr("Send a test notification");
            enabled: Bridge.notify-targets.length > 0;
            clicked => { Bridge.notify-test(); }
        }
    }

    Rectangle {
        height: 1px;
        background: Theme.border;
    }
    Text {
        text: @tr("Events sent");
        color: Theme.text;
        font-weight: 600;
    }
    for e in Bridge.notify-events: HorizontalLayout {
        spacing: 12px;
        Text {
            text: root.event-label(e.key);
            color: Theme.text;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        VerticalLayout {
            alignment: center;
            Toggle {
                checked: e.on;
                toggled(v) => { Bridge.notify-event(e.key, v); }
            }
        }
    }
}

// The owner's guests: people who use this engine for their own Twitch accounts.
component GuestsCard inherits Card {
    property <string> name;
    property <string> confirm;
    SectionTitle {
        text: @tr("Guests");
    }
    Muted {
        text: @tr("Let a friend use this server for their own Twitch account: they only see and change their accounts, never yours nor the engine settings.");
    }
    for g in Bridge.guests: Rectangle {
        border-radius: Theme.radius-m;
        background: Theme.inset;
        HorizontalLayout {
            padding: 10px;
            padding-left: 12px;
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: g.name;
                    font-weight: 600;
                    color: Theme.text;
                }
                Muted {
                    text: g.accounts == "" ? @tr("No account yet") : g.accounts;
                }
            }
            if root.confirm != g.id: VerticalLayout {
                alignment: center;
                Button {
                    compact: true;
                    kind: ButtonKind.ghost;
                    text: @tr("Revoke");
                    clicked => { root.confirm = g.id; }
                }
            }
            if root.confirm == g.id: VerticalLayout {
                alignment: center;
                Button {
                    compact: true;
                    kind: ButtonKind.danger;
                    text: @tr("Revoke the access");
                    clicked => {
                        Bridge.guest-remove(g.id);
                        root.confirm = "";
                    }
                }
            }
        }
    }
    if Bridge.invited-token == "": HorizontalLayout {
        spacing: 6px;
        TextField {
            placeholder: @tr("Their name");
            text <=> root.name;
            accepted => {
                Bridge.guest-invite(root.name);
                root.name = "";
            }
        }
        Button {
            compact: true;
            kind: ButtonKind.primary;
            icon: Icons.plus;
            text: @tr("Invite");
            enabled: root.name != "";
            clicked => {
                Bridge.guest-invite(root.name);
                root.name = "";
            }
        }
    }
    if Bridge.invited-token != "": Rectangle {
        border-radius: Theme.radius-m;
        border-width: 1px;
        border-color: Theme.accent;
        VerticalLayout {
            padding: 12px;
            spacing: 8px;
            Text {
                text: @tr("Access for {} created", Bridge.invited-name);
                font-weight: 600;
                color: Theme.text;
            }
            Muted {
                text: @tr("Send them this token with the server's address. It will not be shown again (revoke and invite again if it is lost). In the app: “Remote server”, then they connect their Twitch account.");
            }
            if Bridge.link != LinkState.local: Muted {
                text: @tr("Server address: {}", Bridge.link-detail);
            }
            SecretRow {
                label: @tr("Token");
                secret: Bridge.invited-token;
            }
            HorizontalLayout {
                alignment: start;
                Button {
                    compact: true;
                    text: @tr("Done");
                    clicked => { Bridge.guest-invited-done(); }
                }
            }
        }
    }
}

// One module: on/off in the header, its options folded.
component ModuleCard inherits Card {
    in property <string> id;
    in property <string> name;
    in property <string> description;
    in property <bool> enabled;
    in property <[FieldItem]> fields;
    property <bool> open: Bridge.dev-expand;
    HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            spacing: 2px;
            horizontal-stretch: 1;
            SectionTitle {
                text: SettingText.module-name(root.id, root.name);
            }
            Muted {
                text: SettingText.module-description(root.id, root.description);
            }
        }
        if root.fields.length > 0: VerticalLayout {
            alignment: center;
            Button {
                compact: true;
                kind: ButtonKind.ghost;
                icon: root.open ? Icons.chevron-down : Icons.chevron-right;
                text: @tr("Options");
                clicked => { root.open = !root.open; }
            }
        }
        VerticalLayout {
            alignment: center;
            Toggle {
                checked: root.enabled;
                toggled(v) => { Bridge.setting-toggle(root.id, "enabled", v); }
            }
        }
    }
    if root.open: Rectangle {
        height: 1px;
        background: Theme.border;
    }
    if root.id == "notify" && !root.open && Bridge.notify-targets.length == 0: Muted {
        text: @tr("No destination yet: open the options to add your phone (ntfy), Discord or Telegram.");
    }
    if root.id == "notify" && root.open: NotifyEditor { }
    if root.open && root.fields.length > 0: Rectangle {
        height: 1px;
        background: Theme.border;
    }
    if root.open: FieldList {
        fields: root.fields;
    }
}


component HoursRow inherits Rectangle {
    in property <int> index;
    in property <HourWindow> window;
    property <string> start: window.start;
    property <string> end: window.end;
    border-radius: Theme.radius-m;
    background: Theme.inset;
    GridLayout {
        min-height: 44px;
        padding-left: 8px;
        padding-right: 4px;
        padding-top: Theme.compact ? 6px : 0px;
        padding-bottom: Theme.compact ? 6px : 0px;
        spacing-horizontal: 10px;
        spacing-vertical: 6px;
        HorizontalLayout {
            row: 0;
            col: 0;
            spacing: 4px;
            for on[d] in root.window.days: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 30px;
                    height: 28px;
                    border-radius: Theme.radius-s;
                    background: on ? Theme.accent-strong : t.has-hover ? Theme.card-hover : transparent;
                    border-width: 1px;
                    border-color: on ? Theme.accent-strong : Theme.border;
                    accessible-role: checkbox;
                    accessible-checkable: true;
                    accessible-checked: on;
                    accessible-label: d == 0 ? @tr("Monday") : d == 1 ? @tr("Tuesday") : d == 2 ? @tr("Wednesday") : d == 3 ? @tr("Thursday") : d == 4 ? @tr("Friday") : d == 5 ? @tr("Saturday") : @tr("Sunday");
                    accessible-action-default => { Bridge.hours-toggle-day(root.index, d); }
                    Text {
                        text: d == 0 ? @tr("Mo") : d == 1 ? @tr("Tu") : d == 2 ? @tr("We") : d == 3 ? @tr("Th") : d == 4 ? @tr("Fr") : d == 5 ? @tr("Sa") : @tr("Su");
                        font-size: Theme.font-xs;
                        font-weight: 600;
                        color: on ? Theme.on-accent : Theme.text-muted;
                    }
                    t := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Bridge.hours-toggle-day(root.index, d); }
                    }
                }
            }
        }
        HorizontalLayout {
            row: Theme.compact ? 1 : 0;
            col: Theme.compact ? 0 : 1;
            spacing: 4px;
            VerticalLayout {
                alignment: center;
                TextField {
                    width: 70px;
                    height: 30px;
                    text <=> root.start;
                    accepted => { Bridge.hours-set(root.index, root.start, root.end); }
                }
            }
            Text {
                text: "→";
                color: Theme.text-faint;
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                TextField {
                    width: 70px;
                    height: 30px;
                    text <=> root.end;
                    accepted => { Bridge.hours-set(root.index, root.start, root.end); }
                }
            }
            VerticalLayout {
                alignment: center;
                Button {
                    compact: true;
                    kind: ButtonKind.ghost;
                    text: @tr("Apply");
                    enabled: root.start != root.window.start || root.end != root.window.end;
                    clicked => { Bridge.hours-set(root.index, root.start, root.end); }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Icons.trash;
                    tooltip: @tr("Remove this time slot");
                    clicked => { Bridge.hours-remove(root.index); }
                }
            }
        }
    }
}

// `active_hours`: watching only happens inside these windows (empty = always).
component HoursEditor inherits VerticalLayout {
    spacing: 8px;
    for w[i] in Bridge.active-hours: HoursRow {
        index: i;
        window: w;
    }
    HorizontalLayout {
        alignment: start;
        Button {
            compact: true;
            icon: Icons.plus;
            text: @tr("Add a time slot");
            clicked => { Bridge.hours-add(); }
        }
    }
}

// Serving the local engine's API: control from a phone or another PC, AI agents.
component ApiAccess inherits VerticalLayout {
    property <string> bind: Bridge.api-bind == "" ? "127.0.0.1:7878" : Bridge.api-bind;
    spacing: 10px;
    Rectangle {
        height: 1px;
        background: Theme.border;
    }
    HorizontalLayout {
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: @tr("Remote access (API)");
                color: Theme.text;
                font-weight: 600;
            }
            Muted {
                text: @tr("Lets a phone, another PC or an AI agent connect to this engine. 127.0.0.1 = this computer only; use your local or Tailscale address to open it to other devices. Restarts the engine.");
            }
        }
        VerticalLayout {
            alignment: center;
            Toggle {
                checked: Bridge.api-bind != "";
                toggled(v) => { Bridge.set-api(v, root.bind); }
            }
        }
    }
    HorizontalLayout {
        spacing: 8px;
        Text {
            text: @tr("Address");
            color: Theme.text;
            font-weight: 600;
            vertical-alignment: center;
        }
        TextField {
            height: 32px;
            text <=> root.bind;
            accepted => { Bridge.set-api(true, root.bind); }
        }
        Button {
            compact: true;
            text: @tr("Apply");
            enabled: root.bind != Bridge.api-bind;
            clicked => { Bridge.set-api(true, root.bind); }
        }
    }
    if Bridge.api-error != "": Text {
        text: @tr("Not available: {}. The engine runs without it; change the address or turn it off.", Bridge.api-error);
        color: Theme.danger;
        wrap: word-wrap;
    }
    if Bridge.api-bind != "" && Bridge.api-error == "": SecretRow {
        label: @tr("API token");
        secret: Bridge.api-token;
    }
}

component LogView inherits VerticalLayout {
    spacing: 8px;
    HorizontalLayout {
        spacing: 8px;
        Muted {
            text: Bridge.logs-error != "" ? @tr("The engine's log could not be read: {}", Bridge.logs-error) : @tr("Most recent first.");
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Button {
            compact: true;
            kind: ButtonKind.ghost;
            icon: Icons.refresh;
            text: @tr("Refresh");
            clicked => { Bridge.logs-refresh(); }
        }
    }
    if Bridge.logs-error == "": Rectangle {
        height: 260px;
        border-radius: Theme.radius-m;
        background: Theme.inset;
        clip: true;
        // Virtualised: only the visible lines exist.
        ListView {
            for l in Bridge.logs: HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 2px;
                padding-bottom: 2px;
                spacing: 8px;
                Text {
                    text: l.time;
                    font-family: "Consolas";
                    font-size: Theme.font-xs;
                    color: Theme.text-faint;
                }
                Text {
                    text: l.level;
                    width: 40px;
                    font-family: "Consolas";
                    font-size: Theme.font-xs;
                    color: l.level == "error" ? Theme.danger : l.level == "warn" ? Theme.warning : Theme.text-faint;
                }
                Text {
                    text: l.message;
                    font-family: "Consolas";
                    font-size: Theme.font-xs;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }
        }
    }
}

export component SettingsScreen inherits Page {
    title: @tr("Settings");
    property <bool> advanced: Bridge.dev-expand;
    init => {
        if Bridge.open-advanced {
            root.advanced = true;
            Bridge.open-advanced = false;
        }
    }

    if Bridge.schemas-error != "": Card {
        Text {
            text: @tr("The engine's settings could not be loaded yet ({}). Trying again…", Bridge.schemas-error);
            color: Theme.warning;
            wrap: word-wrap;
        }
    }

    Card {
        SectionTitle {
            text: @tr("Appearance");
        }
        SettingRow {
            label: @tr("Theme");
            help: @tr("OLED uses pure black, to save battery on OLED screens.");
            Segmented {
                width: 260px;
                items: [
                    { label: @tr("Dark") },
                    { label: @tr("Light") },
                    { label: @tr("OLED") },
                ];
                selected: Theme.mode == ThemeMode.light ? 1 : Theme.mode == ThemeMode.oled ? 2 : 0;
                picked(i) => {
                    Theme.mode = i == 1 ? ThemeMode.light : i == 2 ? ThemeMode.oled : ThemeMode.dark;
                    Bridge.theme-changed(i);
                }
            }
        }
        SettingRow {
            label: @tr("Language");
            // Language names are written in their own language.
            Segmented {
                width: 260px;
                items: [{ label: "Français" }, { label: "English" }];
                selected: Bridge.language;
                picked(i) => { Bridge.language-changed(i); }
            }
        }
    }

    if Bridge.has-autostart || Bridge.keeps-running: Card {
        SectionTitle {
            text: @tr("Startup");
        }
        if Bridge.has-autostart: SettingRow {
            stack: false;
            label: @tr("Start with the session");
            help: @tr("TwitchMiner starts in the system tray when you log in, without opening its window.");
            Toggle {
                checked: Bridge.autostart;
                toggled(v) => { Bridge.set-autostart(v); }
            }
        }
        if Bridge.keeps-running: Muted {
            text: @tr("Closing the window keeps TwitchMiner running in the system tray. To stop it, use “Quit” in the tray icon menu.");
        }
    }

    Card {
        HorizontalLayout {
              SectionTitle {
                  text: @tr("Accounts");
                  vertical-alignment: center;
                  horizontal-stretch: 1;
              }
              Button {
                  compact: true;
                  icon: Icons.plus;
                  text: @tr("Add an account");
                  busy: Bridge.login-busy;
                  clicked => {
                      Bridge.login-start();
                      Bridge.screen = Screen.home;
                  }
              }
        }
        if Bridge.accounts.length == 0: Muted {
            text: @tr("No account yet.");
        }
        for acc in Bridge.accounts: AccountRow {
            account: acc;
        }
    }

    if !Bridge.guest: GuestsCard { }

    // A guest's module settings apply to their accounts: nothing to set without one.
    if Bridge.guest && Bridge.accounts.length == 0: Card {
        Muted {
            text: @tr("Connect your Twitch account: its drops, channel points and notifications are then set here.");
        }
    }
    if !Bridge.guest || Bridge.accounts.length > 0: VerticalLayout {
        spacing: Theme.compact ? 14px : 18px;
        for m in Bridge.module-forms: ModuleCard {
            id: m.id;
            name: m.name;
            description: m.description;
            enabled: m.enabled;
            fields: m.fields;
        }
    }


    // Engine settings: the owner's only.
    if !Bridge.guest: Card {
        SectionTitle {
            text: @tr("Watching");
        }
        FieldList {
            fields: Bridge.engine-main;
        }
        Text {
            text: @tr("Time slots");
            color: Theme.text;
            font-weight: 600;
        }
        Muted {
            text: Bridge.active-hours.length == 0 ? @tr("No time slot: watching at any time. Add one to watch only at certain times (local time; an end before the start goes past midnight).")
                : @tr("Watching only inside these slots (local time; an end before the start goes past midnight). Enter the times as HH:MM.");
        }
        if Bridge.link != LinkState.local: Muted {
            text: @tr("Remote engine: the times are those of the machine running it.");
        }
        HoursEditor { }
    }

    // Advanced, folded by default.
    Rectangle {
        height: 36px;
        accessible-role: button;
        accessible-label: @tr("Advanced");
        accessible-expandable: true;
        accessible-expanded: root.advanced;
        accessible-action-default => { root.advanced = !root.advanced; }
        HorizontalLayout {
              spacing: 6px;
              alignment: start;
              Icon {
                  source: root.advanced ? Icons.chevron-down : Icons.chevron-right;
                  size: 16px;
              }
              Text {
                  text: @tr("Advanced");
                  color: Theme.text-muted;
                  font-weight: 600;
                  vertical-alignment: center;
              }
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.advanced = !root.advanced; }
        }
    }

    if root.advanced: Card {
        SectionTitle {
            text: @tr("Engine");
        }
        SettingRow {
            label: Bridge.link == LinkState.local ? @tr("On this computer") : @tr("Remote server");
            help: Bridge.link == LinkState.local
                ? @tr("The engine runs inside this application.")
                : Fmt.link-detail();
            Button {
                compact: true;
                icon: Icons.server;
                text: @tr("Change…");
                clicked => { Bridge.show-setup(); }
            }
        }
    }

    if root.advanced && !Bridge.guest: Card {
        SectionTitle {
            text: @tr("Network");
        }
        FieldList {
            fields: Bridge.engine-network;
        }
        if Bridge.local-engine: ApiAccess { }
    }

    if root.advanced && !Bridge.guest: Card {
        SectionTitle {
            text: @tr("Several devices");
        }
        Muted {
            text: @tr("A home server can mine while this device stays on standby, and take over if it stops.");
        }
        FieldList {
            fields: Bridge.engine-peers;
        }
    }

    if root.advanced && !Bridge.guest: Card {
        HorizontalLayout {
              spacing: 12px;
              VerticalLayout {
                  spacing: 2px;
                  horizontal-stretch: 1;
                  SectionTitle {
                      text: @tr("AI agent");
                  }
                  Muted {
                      text: @tr("Lets an AI agent (MCP) follow and drive TwitchMiner with a restricted token: no deletions, no files, secrets hidden.");
                  }
              }
              VerticalLayout {
                  alignment: center;
                  Toggle {
                      checked: Bridge.agent-enabled;
                      toggled(v) => { Bridge.setting-toggle("engine", "agent_enabled", v); }
                  }
              }
        }
        if Bridge.agent-enabled && Bridge.agent-token != "": SecretRow {
            label: @tr("Agent token");
            secret: Bridge.agent-token;
        }
        if Bridge.agent-enabled && Bridge.agent-token == "": Muted {
            text: @tr("The agent token of a remote engine is shown on its machine: twitchminer api-token --agent");
        }
    }

    if root.advanced && !Bridge.guest: Card {
        SectionTitle {
            text: @tr("Maintenance");
        }
        FieldList {
            fields: Bridge.engine-maintenance;
        }
    }

    if root.advanced && !Bridge.guest: Card {
        SectionTitle {
            text: @tr("Log");
        }
        LogView { }
    }

    if root.advanced: Card {
        SectionTitle {
            text: @tr("About");
        }
        Muted {
            text: (Bridge.link == LinkState.local ? "TwitchMiner " + Bridge.app-version
                : @tr("Application {} · server {}", Bridge.app-version, Bridge.version))
                + " · " + @tr("Twitch identifiers revision {}", Bridge.manifest-revision);
        }
        if Bridge.update-info.checked: Muted {
            text: Bridge.update-info.phase == UpdatePhase.failed ? @tr("The update failed: {}", Bridge.update-info.error)
                : Bridge.update-info.available ? @tr("Version {} is available.", Bridge.update-info.latest) : @tr("TwitchMiner is up to date.");
        }
        HorizontalLayout {
              spacing: 8px;
              alignment: start;
              Button {
                  compact: true;
                  icon: Icons.refresh;
                  text: @tr("Check for updates");
                  clicked => { Bridge.update-check(); }
              }
              if Bridge.update-info.available && Bridge.update-info.can-install: Button {
                  compact: true;
                  kind: ButtonKind.primary;
                  icon: Icons.download;
                  text: @tr("Update now");
                  busy: Bridge.update-info.phase == UpdatePhase.downloading || Bridge.update-info.phase == UpdatePhase.installing;
                  clicked => { Bridge.update-install(); }
              }
              if Bridge.update-info.available && !Bridge.update-info.can-install && Bridge.update-info.url != "": Button {
                  compact: true;
                  kind: ButtonKind.primary;
                  icon: Icons.external;
                  text: @tr("Download");
                  clicked => { Bridge.open-url(Bridge.update-info.url); }
              }
              if !Bridge.guest: Button {
                  compact: true;
                  text: @tr("Update Twitch identifiers");
                  clicked => { Bridge.manifest-refresh(); }
              }
              if !Bridge.guest: Button {
                  compact: true;
                  text: @tr("Back up the database");
                  clicked => { Bridge.backup(); }
              }
        }
        AboutSlint {
            max-height: 120px;
        }
    }
}
