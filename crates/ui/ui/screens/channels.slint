// Channels: "where am I with channel points?"
// One list of every channel mined for points, with its balance. ★ = priority.

import { Theme } from "../theme.slint";
import { Bridge, ChannelItem } from "../bridge.slint";
import { Fmt } from "../fmt.slint";
import { Avatar, Button, ButtonKind, Card, Icon, IconButton, Icons, Muted, Page, Pill, TextField, Toggle, Tone } from "../widgets.slint";

component SectionTitle inherits Text {
    font-size: Theme.font-l;
    font-weight: 700;
    color: Theme.text;
}

component Stat inherits VerticalLayout {
    in property <string> value;
    in property <string> label;
    spacing: 2px;
    horizontal-stretch: 1;
    Text {
        text: root.label;
        font-size: Theme.font-xs;
        color: Theme.text-muted;
    }
    Text {
        text: root.value;
        font-size: Theme.font-xl;
        font-weight: 700;
        color: Theme.text;
    }
}

component LiveAvatar inherits Rectangle {
    in property <ChannelItem> item;
    in property <length> size: 40px;
    width: size;
    height: size;
    Avatar {
        source: root.item.avatar;
        initial: root.item.initial;
        size: root.size;
        opacity: root.item.live || root.item.pending ? 1 : 0.55;
    }
    if root.item.live: Rectangle {
        x: parent.width - 12px;
        y: parent.height - 12px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Theme.live;
        border-width: 2px;
        border-color: Theme.bg;
    }
}

// One channel: who, live or not, balance, what this session brought, and the two
// actions (priority, stop mining).
component ChannelRow inherits Rectangle {
    in property <ChannelItem> item;
    height: 60px;
    border-radius: Theme.radius-m;
    background: t.has-hover ? Theme.inset : transparent;
    t := TouchArea { }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 4px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            LiveAvatar {
                item: root.item;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.item.name;
                    font-weight: 700;
                    color: Theme.text;
                    overflow: elide;
                    vertical-alignment: center;
                }
                if root.item.priority: Pill {
                    text: @tr("Prioritized");
                    tone: Tone.accent;
                    icon: Icons.star;
                }
                if root.item.watching: Pill {
                    text: @tr("Watched now");
                    tone: Tone.success;
                    icon: Icons.tv;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
            Text {
                text: root.item.excluded ? @tr("In “never mined”: not mined. Click ★ to mine it again.")
                    : root.item.pending ? @tr("Looking for this channel…")
                    : !root.item.live ? @tr("Offline")
                    : root.item.title == "" ? root.item.game
                    : root.item.game == "" ? root.item.title : root.item.game + " · " + root.item.title;
                font-size: Theme.font-s;
                color: root.item.excluded ? Theme.warning : root.item.live ? Theme.text-muted : Theme.text-faint;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            HorizontalLayout {
                spacing: 6px;
                alignment: end;
                if root.item.multiplier != "": VerticalLayout {
                    alignment: center;
                    Pill {
                        text: root.item.multiplier;
                        tone: Tone.success;
                    }
                }
                Text {
                    text: root.item.points-known ? Fmt.int(root.item.points) : "—";
                    font-size: Theme.font-l;
                    font-weight: 700;
                    color: root.item.points-known ? Theme.text : Theme.text-faint;
                    horizontal-alignment: right;
                }
            }
            Text {
                text: root.item.session-points > 0 ? @tr("+{} this session", Fmt.int(root.item.session-points)) : @tr("points");
                font-size: Theme.font-xs;
                color: root.item.session-points > 0 ? Theme.success : Theme.text-faint;
                horizontal-alignment: right;
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.star;
                tint: root.item.priority ? Theme.accent : Theme.text-faint;
                tooltip: root.item.priority ? @tr("Remove from priorities") : @tr("Make it a priority");
                clicked => {
                    if root.item.excluded {
                        Bridge.add-channel(root.item.login);
                    } else if root.item.priority {
                        Bridge.remove-channel(root.item.login);
                    } else {
                        Bridge.add-channel(root.item.login);
                    }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.ban;
                tooltip: @tr("Stop mining this channel");
                clicked => { Bridge.ignore-channel(root.item.login); }
            }
        }
    }
}

// The order between priority channels, reordered by dragging the handle.
component PriorityOrder inherits Rectangle {
    property <length> row-h: 40px;
    property <int> dragging: -1;
    property <int> target: -1;
    property <length> drag-y;
    height: Bridge.my-channels.length * row-h;
    for ch[i] in Bridge.my-channels: Rectangle {
        property <bool> is-dragged: root.dragging == i;
        x: 0;
        width: parent.width;
        height: root.row-h - 4px;
        y: is-dragged ? root.drag-y
            : root.dragging >= 0 && root.dragging < i && i <= root.target ? (i - 1) * root.row-h
            : root.dragging >= 0 && root.target <= i && i < root.dragging ? (i + 1) * root.row-h
            : i * root.row-h;
        animate y {
            duration: is-dragged ? 0ms : 120ms;
            easing: ease-out;
        }
        z: is-dragged ? 1 : 0;
        border-radius: Theme.radius-m;
        background: is-dragged ? Theme.card-hover : Theme.inset;
        drop-shadow-blur: is-dragged ? 14px : 0px;
        drop-shadow-color: #00000050;
        accessible-role: list-item;
        accessible-label: ch.name;
        accessible-action-increment => {
            if i > 0 { Bridge.list-move("points.channels", i, i - 1); }
        }
        accessible-action-decrement => {
            if i + 1 < Bridge.my-channels.length { Bridge.list-move("points.channels", i, i + 1); }
        }
        HorizontalLayout {
            padding-left: 4px;
            padding-right: 8px;
            spacing: 8px;
            Rectangle {
                width: 22px;
                Icon {
                    source: Icons.grip;
                    size: 16px;
                    colorize: Theme.text-faint;
                }
                TouchArea {
                    mouse-cursor: grab;
                    pointer-event(ev) => {
                        if ev.kind == PointerEventKind.down {
                            root.dragging = i;
                            root.target = i;
                            root.drag-y = i * root.row-h;
                        }
                        if ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel {
                            if root.dragging == i && root.target != i && root.target >= 0 {
                                Bridge.list-move("points.channels", i, root.target);
                            }
                            root.dragging = -1;
                            root.target = -1;
                        }
                    }
                    moved => {
                        if root.dragging == i {
                            root.drag-y = clamp(root.drag-y + self.mouse-y - self.pressed-y, 0px, (Bridge.my-channels.length - 1) * root.row-h);
                            root.target = round(root.drag-y / root.row-h);
                        }
                    }
                }
            }
            Text {
                text: i + 1;
                width: 16px;
                font-size: Theme.font-s;
                font-weight: 700;
                color: Theme.accent;
                vertical-alignment: center;
            }
            Text {
                text: ch.name;
                color: Theme.text;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            if ch.live: VerticalLayout {
                alignment: center;
                Pill {
                    text: @tr("Live");
                    tone: Tone.danger;
                }
            }
        }
    }
}

// "When several channels are live, watch first…": one sentence per choice.
component OrderChoice inherits Rectangle {
    in property <int> value;
    in property <string> text;
    property <bool> on: Bridge.points-order == value;
    height: 34px;
    border-radius: Theme.radius-m;
    background: t.has-hover ? Theme.inset : transparent;
    accessible-role: radio-button;
    accessible-checkable: true;
    accessible-checked: on;
    accessible-label: text;
    accessible-action-default => { t.clicked(); }
    HorizontalLayout {
        padding-left: 6px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 8px;
                border-width: 2px;
                border-color: root.on ? Theme.accent : Theme.border-strong;
                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: root.on ? Theme.accent : transparent;
                }
            }
        }
        Text {
            text: root.text;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Bridge.set-module-setting("points", "order_by",
                root.value == 1 ? "\"multiplier\"" : root.value == 2 ? "\"fewest_points\"" : root.value == 3 ? "\"most_points\"" : "\"config\"");
        }
    }
}

export component ChannelsScreen inherits Page {
    title: @tr("Channels");
    subtitle: Bridge.account-name == "" ? @tr("Where am I with channel points?")
        : @tr("Where am I with channel points? Balances of the account {}.", Bridge.account-name);
    property <string> draft;
    property <bool> options;

    if !Bridge.points-enabled: Card {
        Muted {
            font-size: Theme.font-m;
            text: @tr("The channel points module is turned off (Settings).");
        }
    }

    Card {
        HorizontalLayout {
            spacing: 12px;
            Stat {
                label: @tr("Channels");
                value: Bridge.channels-count;
            }
            Stat {
                label: @tr("Live now");
                value: Bridge.channels-live;
            }
            Stat {
                label: @tr("Earned this session");
                value: "+" + Fmt.int(Bridge.channels-session-points);
            }
        }
    }

    Card {
        SectionTitle {
            text: @tr("Your channels");
        }
        Muted {
            text: @tr("TwitchMiner watches up to {} live channels at once to earn their points. ★ Priority channels are watched before the others.", Bridge.watch-slots);
        }
        Rectangle {
            border-radius: Theme.radius-m;
            background: Theme.inset;
            HorizontalLayout {
                padding: 10px;
                padding-left: 12px;
                spacing: 16px;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Text {
                        text: @tr("Also mine the channels I follow");
                        color: Theme.text;
                        font-weight: 600;
                    }
                    Muted {
                        text: Bridge.follows ? @tr("On: every channel you follow on Twitch is in the list below.")
                            : @tr("Off: only the channels you add here are mined.");
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Toggle {
                        checked: Bridge.follows;
                        toggled(v) => { Bridge.set-module-setting("points", "follows", v ? "true" : "false"); }
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            TextField {
                placeholder: @tr("Add a channel (its Twitch name)");
                text <=> root.draft;
                accepted => {
                    Bridge.add-channel(root.draft);
                    root.draft = "";
                }
            }
            Button {
                icon: Icons.plus;
                text: @tr("Add");
                enabled: root.draft != "";
                clicked => {
                    Bridge.add-channel(root.draft);
                    root.draft = "";
                }
            }
        }
        if Bridge.all-channels.length == 0: Muted {
            font-size: Theme.font-m;
            text: Bridge.follows ? @tr("No channel yet: the channels you follow on Twitch appear here, and you can add others above.")
                : @tr("No channel yet. Add one above.");
        }
        VerticalLayout {
            spacing: 2px;
            for ch in Bridge.all-channels: ChannelRow {
                item: ch;
            }
        }
        if Bridge.all-channels.length > 0: Muted {
            color: Theme.text-faint;
            text: @tr("— = balance not known yet: it shows once the channel has been live.");
        }
    }

    if Bridge.my-channels.length >= 2: Card {
        SectionTitle {
            text: @tr("Order of the priorities");
        }
        Muted {
            text: Bridge.points-order == 0 ? @tr("When several priority channels are live, the first one in this list goes first. Drag the handle to change the order.")
                : @tr("This order only breaks ties: the rule chosen in the options decides first.");
        }
        PriorityOrder { }
    }

    Rectangle {
        height: 36px;
        accessible-role: button;
        accessible-label: @tr("Options");
        accessible-expandable: true;
        accessible-expanded: root.options;
        accessible-action-default => { root.options = !root.options; }
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            Icon {
                source: root.options ? Icons.chevron-down : Icons.chevron-right;
                size: 16px;
            }
            Text {
                text: @tr("Options");
                color: Theme.text-muted;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.options = !root.options; }
        }
    }

    if root.options: Card {
        Text {
            text: @tr("When more channels are live than can be watched, watch first:");
            color: Theme.text;
            font-weight: 600;
            wrap: word-wrap;
        }
        VerticalLayout {
            spacing: 2px;
            OrderChoice {
                value: 0;
                text: @tr("My priority channels, in my order");
            }
            OrderChoice {
                value: 1;
                text: @tr("Where my points multiplier is highest (subscriptions)");
            }
            OrderChoice {
                value: 2;
                text: @tr("Where I have the fewest points");
            }
            OrderChoice {
                value: 3;
                text: @tr("Where I have the most points");
            }
        }
        Muted {
            text: @tr("A channel whose watch streak is not secured yet always goes first.");
        }
        if Bridge.excluded-channels.length > 0: VerticalLayout {
            spacing: 6px;
            Rectangle {
                height: 1px;
                background: Theme.border;
            }
            Text {
                text: @tr("Channels never mined");
                color: Theme.text;
                font-weight: 600;
            }
            for login in Bridge.excluded-channels: Rectangle {
                height: 32px;
                border-radius: Theme.radius-m;
                background: Theme.inset;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 4px;
                    Text {
                        text: login;
                        color: Theme.text;
                        font-size: Theme.font-s;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    VerticalLayout {
                        alignment: center;
                        Button {
                            compact: true;
                            kind: ButtonKind.ghost;
                            text: @tr("Mine again");
                            clicked => { Bridge.list-remove("points.exclude", login); }
                        }
                    }
                }
            }
        }
    }
}
